# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development:  cp .env.example .env.local
# On Vercel, add the same variables under Project → Settings → Environment Variables.
# NEVER commit real values. .env.local is git-ignored.
# -----------------------------------------------------------------------------

# --- Client-safe (exposed to the browser; protected by Row Level Security) ---

# Supabase → Project Settings → API (or the "Connect" dialog) → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (starts with sb_publishable_)
# Older projects can use the legacy "anon" key here instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Public origin of the site, no trailing slash. Used for canonical URLs, the
# sitemap and Open Graph. Optional on Vercel (falls back to the production
# *.vercel.app URL), recommended once you know your final URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ---

# Supabase → Project Settings → API Keys → Secret key (starts with sb_secret_)
# Older projects can use the legacy "service_role" key here instead.
# Used ONLY by the contact form to store messages. It bypasses RLS — keep it secret.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: random string used to hash visitor IPs for contact-form rate limiting.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_IP_SALT=
